{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.2.0",
  "identifier": "app.aether.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether",
        "width": 1320,
        "height": 860,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#191c1d",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
